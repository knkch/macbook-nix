// rmpc のテーマ（tokyonight。sketchybar・Ghostty と同じ配色）
// rmpc の作者の公開設定（黒地に青のアクセント、上に曲情報の帯、下に進行バー）を参考にしている
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: "#c0caf5",
    header_background_color: None,
    modal_background_color: "#1a1b26",
    tab_bar: (
        enabled: true,
        active_style: (fg: "#1a1b26", bg: "#7aa2f7", modifiers: "Bold"),
        inactive_style: (fg: "#565f89"),
    ),
    highlighted_item_style: (fg: "#bb9af7", modifiers: "Bold"),
    current_item_style: (fg: "#1a1b26", bg: "#7aa2f7", modifiers: "Bold"),
    borders_style: (fg: "#414868"),
    highlight_border_style: (fg: "#7aa2f7"),
    symbols: (song: "󰎆", dir: "󰉋", marker: "󰄲", ellipsis: "…"),
    progress_bar: (
        symbols: ["━", "●", "─"],
        track_style: (fg: "#292e42"),
        elapsed_style: (fg: "#7aa2f7"),
        thumb_style: (fg: "#bb9af7"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#292e42"),
        ends_style: (fg: "#414868"),
        thumb_style: (fg: "#7aa2f7"),
    ),
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "#bb9af7"),
                default: (kind: Text("Unknown"))
            ),
            width: "25%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            width: "40%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#7dcfff"),
                default: (kind: Text("Unknown Album"), style: (fg: "#565f89"))
            ),
            width: "25%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#565f89"),
                default: (kind: Text("-"))
            ),
            width: "10%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (pane: Pane(Header), size: "2"),
            (pane: Pane(Tabs), size: "3"),
            (pane: Pane(TabContent), size: "100%"),
            (pane: Pane(ProgressBar), size: "1"),
        ],
    ),
    header: (
        rows: [
            (
                left: [
                    (kind: Property(Status(StateV2(playing_label: "  再生中", paused_label: "  一時停止", stopped_label: "  停止"))),
                        style: (fg: "#9ece6a", modifiers: "Bold")),
                ],
                center: [
                    (kind: Property(Song(Title)), style: (fg: "#c0caf5", modifiers: "Bold"),
                        default: (kind: Text("曲が選ばれていません"), style: (fg: "#565f89"))
                    )
                ],
                right: [
                    (kind: Property(Widget(Volume)), style: (fg: "#7aa2f7"))
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed)), style: (fg: "#7aa2f7")),
                    (kind: Text(" / "), style: (fg: "#565f89")),
                    (kind: Property(Status(Duration)), style: (fg: "#565f89")),
                    (kind: Text("  "), style: (fg: "#565f89")),
                    (kind: Property(Status(Bitrate)), style: (fg: "#565f89")),
                    (kind: Text(" kbps"), style: (fg: "#565f89")),
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#bb9af7", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "#565f89"))
                    ),
                    (kind: Text("  ·  "), style: (fg: "#565f89")),
                    (kind: Property(Song(Album)), style: (fg: "#7dcfff"),
                        default: (kind: Text("Unknown Album"), style: (fg: "#565f89"))
                    )
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "#c0caf5", modifiers: "Bold"),
                            separator_style: (fg: "#414868")))
                        ),
                        style: (fg: "#414868")
                    ),
                ]
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
)
